# kiro-power-confluence — local configuration (gitignored, do NOT commit)
#
# Copy this file to server/.env and fill in the three values below.
# The MCP server reads server/.env directly at startup — your token never
# passes through the chat or the agent.
#
# Notes:
#   - CONFLUENCE_BASE_URL MUST start with https:// and MUST NOT end with a trailing slash.
#     For a self-hosted instance the Confluence base often includes an app context path, e.g.:
#       https://confluence.example.com/context/confluence
#     (On shared installs Jira and Confluence usually live under distinct context paths.)
#   - CONFLUENCE_SPACE is the space KEY (as shown in the space URL), not the display name.
#   - The same Personal Access Token used for Jira sometimes works for Confluence on the
#     same instance, but not always — some instances require a Confluence-specific token.
#     Generate one in: Profile → Personal Access Tokens → Create.

# Personal Access Token (Bearer). Treat like a password.
CONFLUENCE_PAT=

# Base URL of the Confluence instance (no trailing slash).
CONFLUENCE_BASE_URL=https://confluence.example.com

# Default space key.
CONFLUENCE_SPACE=MYSPACE
